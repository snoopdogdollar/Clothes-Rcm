# Database Configuration
DATABASE_URL=postgresql://postgres:17062006@localhost:5432/fashion_wardrobe

# Application Settings
SECRET_KEY=your-secret-key-change-this-in-production
DEBUG=True

# File Paths
UPLOAD_FOLDER=./data/uploads
OUTPUT_FOLDER=./output

# Server Settings
API_HOST=0.0.0.0
API_PORT=8000

# Admin Login (single admin - Option A)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_password_here
ADMIN_TOKEN=change_this_to_a_long_random_string

# Ollama (AI outfit chat)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=phi3:latest
# Long read timeout for /api/generate (seconds). If unset, OLLAMA_TIMEOUT is used; else default 900.
OLLAMA_GENERATE_TIMEOUT=1200
OLLAMA_TIMEOUT=1200
# Outfit LLM: short/fast generation (override in .env)
OLLAMA_GENERATE_TEMPERATURE=0.2
OLLAMA_NUM_PREDICT=150
# OLLAMA_TIMEOUT=120

# Must match ingest.py / Langflow indexing (ollama pull nomic-embed-text)
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_EMBED_TIMEOUT=60

# Chroma (same as Langflow — fashion rules RAG)
CHROMA_PERSIST_DIR=D:\langflow_db
CHROMA_COLLECTION=fashion_rules_db
CHROMA_QUERY_K=3

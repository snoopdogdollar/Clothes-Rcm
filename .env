# Database Configuration
DATABASE_URL=postgresql://postgres:17062006@localhost:5432/wardrobe_db

# Application Settings
SECRET_KEY=dev-secret-key-change-this-in-production
DEBUG=True

# File Paths
UPLOAD_FOLDER=./data/uploads
OUTPUT_FOLDER=./output

# Server Settings
API_HOST=0.0.0.0
API_PORT=8000

# Admin Login (Option A - single admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
# Optional: set a fixed token; if empty, token is derived from SECRET_KEY + ADMIN_USERNAME
# ADMIN_TOKEN=

# Ollama (AI outfit chat)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=phi3:latest
# Max wait for LLM /api/generate (seconds). Takes precedence over OLLAMA_TIMEOUT.
OLLAMA_GENERATE_TIMEOUT=1200
OLLAMA_TIMEOUT=1200
OLLAMA_GENERATE_TEMPERATURE=0.2
OLLAMA_NUM_PREDICT=150

# Chroma (same as Langflow — fashion rules RAG)
OLLAMA_EMBED_MODEL=nomic-embed-text
CHROMA_PERSIST_DIR=D:/langflow_db
CHROMA_COLLECTION=fashion_rules_db
CHROMA_QUERY_K=3
